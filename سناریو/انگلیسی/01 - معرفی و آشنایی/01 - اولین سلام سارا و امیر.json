    "grammar": [
      {
        "id": "present-be",
        "title": {
          "fa": "am، are و is برای حال",
          "en": "Present forms of be"
        },
        "explanation": {
          "fa": "برای معرفی خود یا بیان حال، فاعل + شکل مناسب be + اسم یا صفت می‌آید: I با am، you با are و it با is. برخلاف فارسی، فعل را حذف نکن.",
          "en": "To introduce yourself or describe a state, use subject + the appropriate form of be + a noun or adjective: I am, you are, it is. English needs the verb even where another language might omit it."
        },
        "example": {
          "text": "I am fine, thank you.",
          "translation": {
            "fa": "خوبم، ممنونم.",
            "en": "I am fine, thank you."
          }
        },
        "takeaway": {
          "fa": "شکل be را با فاعل هماهنگ کن.",
          "en": "Match be to its subject."
        },
